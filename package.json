{
  "name": "xpi-ts",
  "version": "0.3.1",
  "description": "Bitcore-compatible wallet SDK for Lotus",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./lib/bitcore": {
      "types": "./dist/types/lib/bitcore/index.d.ts",
      "import": "./dist/esm/lib/bitcore/index.js",
      "require": "./dist/cjs/lib/bitcore/index.js"
    },
    "./lib/bitcore/*": {
      "types": "./dist/types/lib/bitcore/*.d.ts",
      "import": "./dist/esm/lib/bitcore/*.js",
      "require": "./dist/cjs/lib/bitcore/*.js"
    },
    "./lib/rank": {
      "types": "./dist/types/lib/rank/index.d.ts",
      "import": "./dist/esm/lib/rank/index.js",
      "require": "./dist/cjs/lib/rank/index.js"
    },
    "./lib/rank/*": {
      "types": "./dist/types/lib/rank/*.d.ts",
      "import": "./dist/esm/lib/rank/*.js",
      "require": "./dist/cjs/lib/rank/*.js"
    },
    "./lib/*": {
      "types": "./dist/types/lib/*.d.ts",
      "import": "./dist/esm/lib/*.js",
      "require": "./dist/cjs/lib/*.js"
    },
    "./utils/*": {
      "types": "./dist/types/utils/*.d.ts",
      "import": "./dist/esm/utils/*.js",
      "require": "./dist/cjs/utils/*.js"
    }
  },
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "gulp build",
    "build:clean": "gulp clean",
    "build:types": "gulp build:types",
    "build:esm": "gulp build:esm",
    "build:cjs": "gulp build:cjs",
    "build:validate": "gulp validate",
    "build:watch": "gulp watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "version": "npm run build",
    "postversion": "git push && git push --tags"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LotusiaStewardship/xpi-ts.git"
  },
  "keywords": [
    "lotus",
    "xpi",
    "lotusia",
    "tools",
    "wallet",
    "rpc",
    "rank"
  ],
  "author": "Lotusia Stewardship",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LotusiaStewardship/xpi-ts/issues"
  },
  "homepage": "https://github.com/LotusiaStewardship/xpi-ts#readme",
  "dependencies": {
    "@noble/hashes": "^1.7.2",
    "bn.js": "5.2.2",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "elliptic": "6.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bn.js": "5.2.0",
    "@types/bs58": "4.0.4",
    "@types/elliptic": "6.4.18",
    "@types/jest": "^29.5.0",
    "@types/node": "24.0.10",
    "gulp": "5.0.1",
    "gulp-cli": "3.1.0",
    "jest": "^29.7.0",
    "prettier": "3.6.2",
    "ts-jest": "^29.1.0",
    "tsx": "^4.21.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.47.0"
  }
}
